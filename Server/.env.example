# Sao chép thành Server/.env và điền giá trị thật trên máy của bạn.
# Không bao giờ commit file .env thật lên Git.

# Cổng backend (mặc định: 8081)
PORT=8081

# Chuỗi kết nối MongoDB, ví dụ local:
# mongodb://127.0.0.1:27017/cutishop1
# hoặc MongoDB Atlas (mongodb+srv://...)
MONGO_URI=

# Khóa bí mật ký JWT — hai chuỗi dài, ngẫu nhiên và KHÁC nhau
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Thời hạn token (tùy chọn; mặc định access 15 phút, refresh 7 ngày)
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Chi phí băm mật khẩu bcrypt (tùy chọn; mặc định 12)
BCRYPT_COST=12

# Các origin frontend được phép gọi API
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

# Địa chỉ gốc của storefront, dùng để tạo link đặt lại mật khẩu trong email
APP_URL=http://127.0.0.1:5173

NODE_ENV=development

# SMTP gửi email đặt lại mật khẩu (để trống = chế độ dev console ở local)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# Cloudinary cho upload ảnh sản phẩm (để trống = tính năng upload báo chưa cấu hình)
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
