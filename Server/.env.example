# Sao chép thành Server/.env và điền giá trị thật trên máy của bạn.
# Không bao giờ commit file .env thật lên Git.

# Cổng backend (mặc định trong code: 8081)
PORT=8081

# Chuỗi kết nối MongoDB, ví dụ local:
# mongodb://127.0.0.1:27017/tokyolife
# hoặc MongoDB Atlas (mongodb+srv://...)
MONGO_URI=

# Khóa bí mật ký JWT — tự đặt một chuỗi dài, ngẫu nhiên
SECRET_KEY=

# Các origin frontend được phép gọi API (React dev servers)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

# Địa chỉ gốc của storefront, dùng để tạo link trong email
URL=http://127.0.0.1:5173

NODE_ENV=development

# Email gửi thông báo / đặt lại mật khẩu (mật khẩu ứng dụng)
MAIL_NAME=
MAIL_PASSWORD=

# Cloudinary cho upload ảnh sản phẩm
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
